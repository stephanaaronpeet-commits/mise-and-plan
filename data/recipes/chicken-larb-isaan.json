  "steps": [
    {
      "n": 1,
      "text": "Heat 1 tsp oil in non-stick pan, medium-high.",
      "timer_min": null
    },
    {
      "n": 2,
      "text": "Add minced chicken. Break up with spatula. Cook until no pink, ~6 min.",
      "timer_min": 6
    },
    {
      "n": 3,
      "text": "Kill heat. Add fish sauce, lime juice, rice powder, chili flakes. Stir to coat.",
      "timer_min": null
    },
    {
      "n": 4,
      "text": "Add shallot, spring onion, mint, cilantro. Toss once — herbs should stay bright, not wilt.",
      "timer_min": null
    },
    {
      "n": 5,
      "text": "Taste. Adjust: more lime for sour, more fish sauce for salt, more chili for heat. Serve immediately.",
      "timer_min": null
    }
