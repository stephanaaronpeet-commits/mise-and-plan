      "ratio": "1:1",
      "macro_delta": {
        "kcal": 40,
        "protein_g": -3,
        "fat_g": 5
      },
      "note": "More traditional. Slightly higher fat — fine if not on cut."
    },
    {
      "swap_out": "chicken breast",
      "swap_in": "firm tofu + 2 eggs",
      "ratio": "500g tofu + 2 large eggs",
      "macro_delta": {
        "kcal": -90,
        "protein_g": -10,
        "carbs_g": 4,
        "fat_g": 2
